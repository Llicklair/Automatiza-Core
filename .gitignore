*.log
logs/

# Windows shell artifact: cuando un comando con `>/dev/null` se ejecuta en
# PowerShell (en vez de bash/MSYS), Windows lo interpreta como un fichero
# llamado `nul`. No es tracking-worthy, no usarlo nunca como nombre real.
/nul

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Caches pip/local
backend/.cache/
backend/.local/

# Runtime / build temporales
