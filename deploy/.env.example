# Copia este archivo a `.env` (en esta carpeta deploy/) y rellena los valores.

# Dominio que apunta al servidor (registro A/AAAA ya configurado).
DOMAIN=erp.ejemplo.com

# Genera con: openssl rand -hex 32   (NUNCA el valor por defecto)
SECRET_KEY=

# Contraseñas de PostgreSQL (admin y rol de aplicación). Genera dos distintas:
#   openssl rand -hex 16
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
