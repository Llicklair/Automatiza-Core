# Entorno
ENVIRONMENT=development
SECRET_KEY=dev_secret_key_change_in_production
TENANT_ENCRYPTION_KEY=dev_tenant_encryption_key_change_in_production

# PostgreSQL
POSTGRES_USER=pyme_user
POSTGRES_PASSWORD=pyme_pass
POSTGRES_DB=pyme_db
DATABASE_URL=postgresql+asyncpg://pyme_user:pyme_pass@localhost:5433/pyme_db

# LLM APIs
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Telegram Bot (mensajería / integraciones — opcional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=genera_un_secreto_largo
# TELEGRAM_WEBHOOK_URL=https://tu-dominio.com/api/v1/messaging/telegram/webhook

# ── Marketing / Redes sociales (opcional) ────────────────────────────────
# Guía completa de alta de apps: docs/oauth-social-setup.md
#
# Callback OAuth. Debe coincidir EXACTO con lo registrado en cada plataforma.
# Si usas OAUTH_PROXY_URL, registra en su lugar {OAUTH_PROXY_URL}/oauth/cb
# OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/marketing/oauth/callback
#
# Proxy de OAuth/imágenes (Render). Si se define, el intercambio code→token
# ocurre en el servidor (que guarda los client_secret) y las plataformas
# aceptan el redirect HTTPS. Déjalo vacío para flujo 100% local con localhost.
# OAUTH_PROXY_URL=https://automatizapyme-license-server.onrender.com
#
# Meta — una sola app cubre Facebook + Instagram (Instagram Business + Página FB)
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# INSTAGRAM_CLIENT_ID=        # mismo valor que Facebook si es una Meta app
# INSTAGRAM_CLIENT_SECRET=
#
# X / Twitter (OAuth2 + PKCE)
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
#
# LinkedIn (requiere Company Page — oculto en la UI por defecto)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
#
# Unsplash — imágenes de stock para los posts (sin esto, fallback al proxy)
# UNSPLASH_ACCESS_KEY=
#
# Generación de imágenes con IA (usa OPENAI_API_KEY de arriba). Opcional.
# OPENAI_IMAGE_MODEL=dall-e-3
