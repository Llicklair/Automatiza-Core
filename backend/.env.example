# Entorno
ENVIRONMENT=development
SECRET_KEY=dev_secret_key_change_in_production
TENANT_ENCRYPTION_KEY=dev_tenant_encryption_key_change_in_production

# PostgreSQL
POSTGRES_USER=pyme_user
POSTGRES_PASSWORD=pyme_pass
POSTGRES_DB=pyme_db
DATABASE_URL=postgresql+asyncpg://pyme_user:pyme_pass@localhost:5432/pyme_db

# LLM APIs
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

