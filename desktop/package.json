{
  "name": "automatizacore-desktop",
  "version": "1.0.0",
  "description": "AutomatizaCore - ERP de escritorio para PYMEs",
  "author": "Marcos Recio <marcosreciosanchez@gmail.com>",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "generate-icon": "node -e \"require('png-to-ico')('assets/icon.png').then(b => require('fs').writeFileSync('assets/icon.ico', b)).catch(e => { console.error('generate-icon failed:', e.message); process.exit(1); })\"",
    "predist": "node sanitize-env.js",
    "dist": "electron-builder",
    "sync": "node sync.js",
    "sync:rebuild": "node sync.js --rebuild-frontend"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "node-forge": "^1.4.0",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.automatizacore.desktop",
    "productName": "AutomatizaCore",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "afterPack": "./afterPack.js",
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AutomatizaCore",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Llicklair",
      "repo": "automatizacore-releases"
    },
    "files": [
      "main.js",
      "launch.js",
      "preload.js",
      "https-proxy.js",
      "service-manager.js",
      "postgres-manager.js",
      "python-manager.js",
      "jre-manager.js",
      "network-utils.js",
      "tray-manager.js",
      "splash.html",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      },
      {
        "from": "../backend",
        "to": "project/backend",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!.venv/**",
          "!*.pyc"
        ]
      },
      {
        "from": ".env.dist",
        "to": "project/.env"
      },
      {
        "from": "../frontend",
        "to": "project/frontend",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!.next/**"
        ]
      }
    ]
  }
}
