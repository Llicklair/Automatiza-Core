# Variables de entorno del proyecto
# Completa estos valores y renombra este archivo como .env

# Seguridad — claves generadas aleatoriamente (Generalas en produccion)
SECRET_KEY=TU_SECRET_KEY_AQUI
TENANT_ENCRYPTION_KEY=TU_ENCRYPTION_KEY_AQUI

FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# URL pública del portal de clientes — la que verán los clientes al abrir el enlace.
# Para piloto local en LAN: http://<tu-IP-LAN>:3000 (accesible desde el wifi de la oficina).
# Para producción real con clientes externos: usa Cloudflare Tunnel, ngrok o dominio propio.
# Si dejas vacío, el frontend caerá a window.location.origin con un warning visible.
PORTAL_PUBLIC_URL=

# Proveedores de IA (Rellena solo el que vayas a usar)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6   # opciones: claude-sonnet-4-6 | claude-opus-4-6

# Embeddings — modelo local sin coste ni API key (descarga ~570MB la primera vez)
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_LOCAL_MODEL=BAAI/bge-m3

GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# DEFAULT_LLM_PROVIDER opciones: anthropic | openai | groq | openrouter | claude_code
DEFAULT_LLM_PROVIDER=claude_code

# Trace LLM — registra cada llamada en JSONL para depurar timeouts y respuestas inesperadas.
# Inspecciónalo con: python backend/scripts/llm_log_tail.py --grouped
LLM_TRACE_ENABLED=false
LLM_TRACE_DIR=logs/llm

# OAuth — Google (Gmail + Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/integrations/google/callback

# OAuth — Microsoft (Outlook + OneDrive)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8080/api/v1/integrations/microsoft/callback

# SMTP — recuperación de contraseña
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Postgres Portable DB credentials
POSTGRES_USER=pyme_user
POSTGRES_PASSWORD=pyme_pass
POSTGRES_DB=pyme_db
